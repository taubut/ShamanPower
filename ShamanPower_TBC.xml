<Ui xmlns = "http://www.blizzard.com/wow/ui/" xmlns:xsi = "http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation = "http://www.blizzard.com/wow/ui/ C:\Projects\WoW\Bin\Interface\FrameXML\UI.xsd">

<!-- Combat-Functional Totem Button Templates (TotemTimers architecture) -->
<!-- Parent totem button: parented to UIParent, enables combat flyouts -->
<!-- NOTE: No ActionButtonTemplate - just secure templates to avoid visual clutter -->
	<Button name="SPTotemButtonTemplate" virtual="true" frameStrata="MEDIUM"
		inherits="SecureActionButtonTemplate, SecureHandlerEnterLeaveTemplate, SecureHandlerAttributeTemplate, SecureHandlerMouseUpDownTemplate, SecureHandlerBaseTemplate">
		<Size x="26" y="26"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" setAllPoints="true"/>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture name="$parentHighlight" alphaMode="ADD" setAllPoints="true">
					<Color r="1" g="1" b="1" a="0.3"/>
				</Texture>
			</Layer>
		</Layers>
	</Button>

<!-- Flyout button: child of parent button, responds to ChildUpdate -->
<!-- NOTE: No ActionButtonTemplate - just secure templates to avoid visual clutter -->
	<Button name="SPFlyoutButtonTemplate" virtual="true" frameStrata="DIALOG"
		inherits="SecureActionButtonTemplate, SecureHandlerEnterLeaveTemplate, SecureHandlerShowHideTemplate, SecureHandlerBaseTemplate">
		<Size x="28" y="28"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" setAllPoints="true"/>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture name="$parentHighlight" alphaMode="ADD" setAllPoints="true">
					<Color r="1" g="1" b="1" a="0.3"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				self:RegisterForClicks("AnyUp", "AnyDown")
				self:Hide()
			</OnLoad>
		</Scripts>
	</Button>

	<!-- Mini Totem Bar - 4 clickable totem buttons + Drop All (VERTICAL layout) -->
	<Frame name = "ShamanPowerAutoButtonTemplate" virtual = "true" frameStrata = "LOW">
		<Size>
			<AbsDimension x = "34" y = "172"/>
		</Size>
		<KeyValues>
			<KeyValue key="backdropInfo" value="BACKDROP_TOOLTIP_8_8_1111" type="global" />
		</KeyValues>
		<Frames>
			<!-- Earth Totem Button -->
			<CheckButton name = "$parentTotem1" inherits = "SecureActionButtonTemplate, SecureHandlerEnterLeaveTemplate, SecureHandlerAttributeTemplate">
				<Size>
					<AbsDimension x = "26" y = "26"/>
				</Size>
				<Anchors>
					<Anchor point = "TOPLEFT" relativePoint = "TOPLEFT">
						<Offset>
							<AbsDimension x = "4" y = "-4"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level = "ARTWORK">
						<Texture name = "$parentIcon" file = "Interface\Icons\Spell_Nature_EarthElemental_Totem" setAllPoints = "true"/>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>ShamanPower:TotemBarTooltip(self, 1)</OnEnter>
					<OnLeave>GameTooltip:Hide()</OnLeave>
				</Scripts>
			</CheckButton>
			<!-- Fire Totem Button -->
			<CheckButton name = "$parentTotem2" inherits = "SecureActionButtonTemplate, SecureHandlerEnterLeaveTemplate, SecureHandlerAttributeTemplate">
				<Size>
					<AbsDimension x = "26" y = "26"/>
				</Size>
				<Anchors>
					<Anchor point = "TOP" relativeTo = "$parentTotem1" relativePoint = "BOTTOM">
						<Offset>
							<AbsDimension x = "0" y = "-4"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level = "ARTWORK">
						<Texture name = "$parentIcon" file = "Interface\Icons\Spell_Fire_SealOfFire" setAllPoints = "true"/>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>ShamanPower:TotemBarTooltip(self, 2)</OnEnter>
					<OnLeave>GameTooltip:Hide()</OnLeave>
				</Scripts>
			</CheckButton>
			<!-- Water Totem Button -->
			<CheckButton name = "$parentTotem3" inherits = "SecureActionButtonTemplate, SecureHandlerEnterLeaveTemplate, SecureHandlerAttributeTemplate">
				<Size>
					<AbsDimension x = "26" y = "26"/>
				</Size>
				<Anchors>
					<Anchor point = "TOP" relativeTo = "$parentTotem2" relativePoint = "BOTTOM">
						<Offset>
							<AbsDimension x = "0" y = "-4"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level = "ARTWORK">
						<Texture name = "$parentIcon" file = "Interface\Icons\Spell_Frost_SummonWaterElemental" setAllPoints = "true"/>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>ShamanPower:TotemBarTooltip(self, 3)</OnEnter>
					<OnLeave>GameTooltip:Hide()</OnLeave>
				</Scripts>
			</CheckButton>
			<!-- Air Totem Button -->
			<CheckButton name = "$parentTotem4" inherits = "SecureActionButtonTemplate, SecureHandlerEnterLeaveTemplate, SecureHandlerAttributeTemplate">
				<Size>
					<AbsDimension x = "26" y = "26"/>
				</Size>
				<Anchors>
					<Anchor point = "TOP" relativeTo = "$parentTotem3" relativePoint = "BOTTOM">
						<Offset>
							<AbsDimension x = "0" y = "-4"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level = "ARTWORK">
						<Texture name = "$parentIcon" file = "Interface\Icons\Spell_Nature_InvisibilityTotem" setAllPoints = "true"/>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>ShamanPower:TotemBarTooltip(self, 4)</OnEnter>
					<OnLeave>GameTooltip:Hide()</OnLeave>
				</Scripts>
			</CheckButton>
			<!-- Drop All Button - cycles through totems -->
			<Button name = "$parentDropAll" inherits = "SecureActionButtonTemplate">
				<Size>
					<AbsDimension x = "26" y = "26"/>
				</Size>
				<Anchors>
					<Anchor point = "TOP" relativeTo = "$parentTotem4" relativePoint = "BOTTOM">
						<Offset>
							<AbsDimension x = "0" y = "-6"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level = "ARTWORK">
						<Texture name = "$parentIcon" file = "Interface\Icons\Spell_Nature_EarthBindTotem" setAllPoints = "true"/>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>ShamanPower:DropAllTooltip(self)</OnEnter>
					<OnLeave>GameTooltip:Hide()</OnLeave>
					<PostClick>ShamanPower:AdvanceDropAllTotem(self, button, down)</PostClick>
				</Scripts>
			</Button>
			<!-- Totemic Call Button - recalls all totems (optional, shown when "Recall on Totem Bar" is enabled) -->
			<Button name = "$parentTotemicCall" inherits = "SecureActionButtonTemplate">
				<Size>
					<AbsDimension x = "26" y = "26"/>
				</Size>
				<Anchors>
					<Anchor point = "TOP" relativeTo = "$parentDropAll" relativePoint = "BOTTOM">
						<Offset>
							<AbsDimension x = "0" y = "-2"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level = "ARTWORK">
						<Texture name = "$parentIcon" file = "Interface\Icons\Spell_Shaman_TotemRecall" setAllPoints = "true"/>
					</Layer>
				</Layers>
				<Scripts>
					<OnEnter>ShamanPower:TotemicCallTooltip(self)</OnEnter>
					<OnLeave>GameTooltip:Hide()</OnLeave>
				</Scripts>
			</Button>
		</Frames>
	</Frame>

	<!-- ShamanPower Buff Frames -->
	<Frame name="ShamanPowerFrame" movable="true" frameStrata="LOW" enableMouse="true" parent="UIParent" hidden="false">
		<Size>
			<AbsDimension x = "1" y = "1"/>
		</Size>
		<Anchors>
			<Anchor point = "CENTER">
				<Offset x = "0" y = "0"/>
			</Anchor>
		</Anchors>
		<Frames>
			<CheckButton name = "ShamanPowerAnchor" enableMouse = "true" frameStrata = "LOW" inherits = "SecureHandlerStateTemplate">
				<Scripts>
					<OnLoad>
						self:RegisterForDrag("LeftButton");
						self:RegisterForClicks("LeftButtonUp", "RightButtonUp");
					</OnLoad>
					<OnClick>
						ShamanPower:ClickHandle(self, button, down);
					</OnClick>
					<OnDragStart>
						ShamanPower:DragStart(self, button);
					</OnDragStart>
					<OnDragStop>
						ShamanPower:DragStop(self, button);
					</OnDragStop>
					<OnEnter>
						if ShamanPower.opt.ShowTooltips then
							GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
							GameTooltip:SetText(ShamanPower.CONFIG_DRAGHANDLE);
							GameTooltip:Show(self, motion);
							CursorUpdate(self, motion);
						end
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide(self, motion);
					</OnLeave>
				</Scripts>
				<Size>
					<AbsDimension x = "16" y = "16"/>
				</Size>
				<Anchors>
					<Anchor point = "CENTER" relativeTo = "$parent" relativePoint = "CENTER"/>
				</Anchors>
				<NormalTexture file = "Interface\AddOns\ShamanPower\Icons\draghandle"/>
				<CheckedTexture file = "Interface\AddOns\ShamanPower\Icons\draghandle-checked"/>
			</CheckButton>
			<Frame name="ShamanPowerHeader" toplevel="true" movable="true" enableMouse="true" resizable="true" frameStrata="LOW" inherits="SecureHandlerStateTemplate">
				<Size x = "1" y = "1"/>
				<Anchors>
					<Anchor point = "CENTER" relativeTo = "$parent" relativePoint = "CENTER"/>
				</Anchors>
			</Frame>
		</Frames>
	</Frame>
</Ui>
